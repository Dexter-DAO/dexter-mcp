{
  "name": "dexter-mcp",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "version": "0.4.0",
  "type": "module",
  "description": "Dexter MCP HTTP server with Supabase OAuth",
  "scripts": {
    "start": "node http-server-oauth.mjs",
    "monitor": "node scripts/studio-monitor.mjs",
    "studio": "node scripts/studio.mjs",
    "studio:setup": "npm install --prefix scripts/studio-runtime --ignore-scripts",
    "mcp:sessions": "node scripts/mcp-sessions.mjs",
    "mcp:sessions:json": "node scripts/mcp-sessions.mjs --json",
    "test:pumpstream": "node scripts/run-pumpstream-harness.js",
    "verify:release:runtime": "node scripts/verify-open-release-dependencies.mjs --runtime",
    "verify:release:source": "node scripts/verify-open-release-dependencies.mjs --source",
    "verify:release:lock": "node scripts/verify-open-release-dependencies.mjs --lock",
    "verify:release:installed": "node scripts/verify-open-release-dependencies.mjs --installed",
    "verify:release:registry": "npm run verify:release:runtime && npm run verify:release:lock && npm run verify:release:installed",
    "build:runtime-workspaces": "npm run build -w @dexterai/x402-core",
    "typecheck:open-release": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --jsx react-jsx --allowImportingTsExtensions apps-sdk/ui/src/sdk/mcp-apps-bridge.ts apps-sdk/ui/src/sdk/call-tool-result.ts",
    "build:apps-sdk:local": "vite build --config apps-sdk/vite.config.ts",
    "build:apps-sdk": "npm run build:apps-sdk:local && npm run deploy:apps-sdk && npm run sentry:apps-sdk:upload",
    "deploy:apps-sdk": "node scripts/deploy-apps-sdk.mjs",
    "sentry:apps-sdk:upload": "node scripts/upload-apps-sdk-sourcemaps.mjs",
    "deploy:mcp": "npm run verify:release:runtime && npm run verify:release:lock && npm ci && npm run build:runtime-workspaces && npm run verify:release:installed && npm run build:apps-sdk && pm2 restart dexter-mcp"
  },
  "dependencies": {
    "@dexterai/mcp-instructions": "2.4.0",
    "@dexterai/vault": "0.43.0",
    "@dexterai/x402": "^5.4.2",
    "@dexterai/x402-core": "1.5.0",
    "@dexterai/x402-mcp-tools": "0.8.0",
    "@dexterai/x402-skills": "file:./packages/x402-skills",
    "@modelcontextprotocol/ext-apps": "1.6.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@openai/apps-sdk-ui": "^0.2.1",
    "@sentry/browser": "^10.43.0",
    "@sentry/node": "^10.40.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tavily/core": "^0.5.12",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "playwright": "^1.48.2",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "x402": "^0.6.6",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.161",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
